# Railway PostgreSQL Database Connection (Required)
DATABASE_URL=postgresql://postgres:password@host:port/database_name

# Password Salt for Authentication (REQUIRED)
# The previous default value is committed in git history; do NOT reuse it.
# Generate a fresh random salt for each environment and store the corresponding
# bcrypt/sha256 hash in app_config.search_password_hash.
PASSWORD_SALT=your_secure_random_salt_here

# Environment (Required for production)
NODE_ENV=development

# Note: In Railway, set these as environment variables in the dashboard:
# - DATABASE_URL: Your Railway PostgreSQL connection string
# - PASSWORD_SALT: A secure random salt for password hashing
# - NODE_ENV: Set to 'production' for production deployment